{
  "input": [
    {
      "type": "maxmindGeoLite2CountryCSV",
      "action": "add",
      "args": {
        "country": "./geolite2/GeoLite2-Country-Locations-en.csv",
        "ipv4": "./geolite2/GeoLite2-Country-Blocks-IPv4.csv",
        "ipv6": "./geolite2/GeoLite2-Country-Blocks-IPv6.csv"
      }
    },
    {
      "type": "cutter",
      "action": "remove",
      "args": {
        "wantedList": ["cn"]
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "cn",
        "uri": "https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china.txt",
        "onlyIPType": "ipv4"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "cn",
        "uri": "https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china6.txt",
        "onlyIPType": "ipv6"
      }
    },
    // ==================== 海外 AI 厂商核心数据源 ====================
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "openai",
        "uri": "https://openai.com/v1/ip-blocks.txt"
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "anthropic",
        "uri": "https://www.anthropic.com/supported-countries.json",
        "jsonPath": ["interconnects.#.ipv4_prefix", "interconnects.#.ipv6_prefix"]
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "perplexity",
        "uri": "https://www.perplexity.ai/perplexity-user-useragents.txt"
      }
    },
    // ==================== 谷歌官方业务解耦拆分 (含 Google Cloud CDN) ====================
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "google",
        "uri": "https://www.gstatic.com/ipranges/goog.json",
        "jsonPath": ["prefixes.#.ipv4Prefix", "prefixes.#.ipv6Prefix"]
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "googlecloud",
        "uri": "https://www.gstatic.com/ipranges/cloud.json",
        "jsonPath": ["prefixes.#.ipv4Prefix", "prefixes.#.ipv6Prefix"]
      }
    },
    // ==================== 核心基础设施与 CDN 官方数据源 ====================
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "aws",
        "uri": "https://ip-ranges.amazonaws.com/ip-ranges.json",
        "jsonPath": [
          "prefixes.#(service!=\"CLOUDFRONT\")#.ip_prefix",
          "ipv6_prefixes.#(service!=\"CLOUDFRONT\")#.ipv6_prefix"
        ]
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "cloudfront",
        "uri": "https://ip-ranges.amazonaws.com/ip-ranges.json",
        "jsonPath": [
          "prefixes.#(service==\"CLOUDFRONT\")#.ip_prefix",
          "ipv6_prefixes.#(service==\"CLOUDFRONT\")#.ipv6_prefix"
        ]
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "oracle",
        "uri": "https://docs.oracle.com/iaas/Content/General/Concepts/address_ranges.json",
        "jsonPath": ["regions.#.cidrs.#.cidr"]
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "azure",
        "uri": "https://raw.githubusercontent.com/wxdjs/Azure-ServiceTags/main/ServiceTags_Public.json",
        "jsonPath": ["values.#.properties.addressPrefixes.#"]
      }
    },
    // ==================== Cloudflare 专属网络数据源 ====================
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "cloudflare",
        "uri": "https://www.cloudflare.com/ips-v4"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "cloudflare",
        "uri": "https://www.cloudflare.com/ips-v6"
      }
    },
    // ==================== ASN 精准业务、流媒体与 CDN 矩阵剥离 ====================
    {
      "type": "maxmindGeoLite2ASNCSV",
      "action": "add",
      "args": {
        "ipv4": "./geolite2/GeoLite2-ASN-Blocks-IPv4.csv",
        "ipv6": "./geolite2/GeoLite2-ASN-Blocks-IPv6.csv",
        "wantedList": {
          "telegram": ["AS62041", "AS62014", "AS59930", "AS44907", "AS211157"],
          "twitter": ["AS63179", "AS54888", "AS35995", "AS13414"],
          "xai": ["AS39121", "AS40122"],
          "midjourney": ["AS399534"],
          "runway": ["AS397034"],
          "huggingface": ["AS399491", "AS27375"],
          "youtube": ["AS43515", "AS36040", "AS36039", "AS19448", "AS19425"],
          "gemini": ["AS396982", "AS396178", "AS395973", "AS394639", "AS394507", "AS394089", "AS214611", "AS214609"],
          "google": ["AS15169", "AS6432", "AS55023", "AS45566", "AS41264", "AS40873", "AS36987", "AS36561", "AS36520", "AS36492", "AS36411", "AS36385", "AS36384", "AS36383", "AS33715", "AS32381", "AS26910", "AS26684", "AS22859", "AS22577", "AS209539", "AS209519", "AS209504", "AS19527", "AS16591", "AS16550", "AS151231", "AS13949", "AS139190", "AS139070"],
          "facebook": ["AS63293", "AS54115", "AS34825", "AS32934", "AS149642"],
          "apple": ["AS17", "AS714", "AS6185", "AS23440"],
          "netflix": ["AS55095", "AS40027", "AS394406", "AS2906"],
          "disney": ["AS394500", "AS19207", "AS19202", "AS22944"],
          "primevideo": ["AS16509", "AS14618", "AS8983"],
          "hulu": ["AS23332", "AS33297"],
          "spotify": ["AS54104", "AS43554", "AS395567", "AS394143"],
          "paramount": ["AS4434", "AS394334", "AS13636", "AS394627"],
          "peacock": ["AS33285", "AS11736", "AS395562"],
          "appletv": ["AS6185", "AS714"],
          "fastly": ["AS895", "AS54113", "AS394192", "AS54114", "AS6407"],
          "akamai": ["AS16625", "AS20940", "AS35908", "AS12222", "AS34122", "AS18610", "AS30675", "AS14131", "AS21344"],
          "bunnycdn": ["AS20473", "AS9436", "AS60338"],
          "jsdelivr": ["AS395804", "AS210541"]
        }
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "tor",
        "uri": "https://check.torproject.org/torbulkexitlist"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "telegram",
        "uri": "https://core.telegram.org/resources/cidr.txt"
      }
    },
    {
      "type": "private",
      "action": "add"
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip.dat"
      }
    },
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip-only-cn-private.dat",
        "wantedList": ["cn", "private"]
      }
    },
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip-asn.dat",
        "wantedList": ["telegram", "twitter", "tor"]
      }
    },
    // ==================== 终极：将所有海外顶级厂牌、独立CDN、以及主流国家并入单包输出 ====================
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "oneFilePerList": true,
        "wantedList": [
          // 🗺️ 显式定义的主流节点国家（未列出的国家也会自动生成独立的单文件）
          "us", "jp", "kr", "sg", "hk", "tw", "gb", "de", "fr", "nl", "ru", "ca", "au", "tr", "in", "my", "th", "ph", "id", "vn",
          // 🌐 8 大独立 CDN
          "cloudflare", "cloudfront", "fastly", "akamai", "bunnycdn", "jsdelivr", "googlecloud", "azure",
          // 📺 8 大独立流媒体矩阵
          "paramount", "peacock", "appletv", "spotify", "netflix", "disney", "primevideo", "hulu", "youtube",
          // 🤖 5 大尖端 AI 厂牌
          "openai", "anthropic", "gemini", "xai", "perplexity", "midjourney", "runway", "huggingface",
          // 🏢 顶级厂牌与底层网络
          "apple", "facebook", "aws", "oracle", "google", "cn", "private"
        ]
      }
    },
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "oneFilePerList": true
      }
    },
    // =================================================================================
    {
      "type": "maxmindMMDB",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "Country.mmdb",
        "sourceMMDBURI": "./output/GeoLite2-Country.mmdb",
        "overwriteList": [
          "cn",
          // 🗺️ 主流国家防污染覆盖
          "us", "jp", "kr", "sg", "hk", "tw", "gb", "de", "fr", "nl", "ru", "ca", "au", "tr", "in",
          // 🌐 CDN
          "cloudflare", "cloudfront", "fastly", "akamai", "bunnycdn", "jsdelivr", "googlecloud", "azure",
          // 📺 流媒体
          "paramount", "peacock", "appletv", "spotify", "netflix", "disney", "primevideo", "hulu", "youtube",
          // 🤖 AI
          "openai", "anthropic", "gemini", "xai", "perplexity", "midjourney", "runway", "huggingface",
          // 🏢 核心大厂
          "apple", "facebook", "telegram", "twitter", "tor", "aws", "oracle", "private"
        ]
      }
    },
    {
      "type": "singboxSRS",
      "action": "output"
    },
    {
      "type": "mihomoMRS",
      "action": "output"
    },
    {
      "type": "text",
      "action": "output"
    },
    {
      "type": "clashRuleSetClassical",
      "action": "output"
    },
    {
      "type": "clashRuleSet",
      "action": "output"
    },
    {
      "type": "surgeRuleSet",
      "action": "output"
    }
  ]
}
